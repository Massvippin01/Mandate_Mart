# ==============================================================================
# 🛡️ MandateMart — Comprehensive .gitignore
# Covers Python backend (FastAPI/SQLite/Ed25519) & Node frontend (Next.js 15/Tailwind)
# ==============================================================================

# --- Node / Next.js / Frontend ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output & cache
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
coverage/
.nyc_output/

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Pytest / Mypy / Linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- SQLite & Database Files ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Environment Variables & Secrets ---
# NEVER commit production keys or sensitive secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example environment templates committed
!.env.example
!*.env.example

# --- Certificates & Keys ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Logs & Debugging ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Vercel ---
.vercel/
